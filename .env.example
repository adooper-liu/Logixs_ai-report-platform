# P0 runtime configuration reference; not working credentials.
# Generate your own .env: python -I tools/init_dev_env.py --output .env
# .env is read only when explicitly passed to tools/control.py or Compose.
APP_ENV=development
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CONTROL_DATABASE_URL=
CONTROL_MIGRATION_DATABASE_URL=
REDIS_URL=
BLOB_BACKEND=local
# Must be an absolute private directory outside application code.
BLOB_ROOT=
AI_ENABLED=false
AI_ALLOW_RAW_SAMPLE_EGRESS=false
# Compose-only bootstrap/owner credentials; never supplied to the control API.
POSTGRES_PASSWORD=
CONTROL_OWNER_PASSWORD=
CONTROL_APP_PASSWORD=
WAREHOUSE_OWNER_PASSWORD=
SUPERSET_OWNER_PASSWORD=
REDIS_PASSWORD=
# The AI adapter, warehouse processing and Superset integration are not implemented in P0.
# Do not configure model credentials until data policy and budget are approved.
