{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design-time normalization recommendation subset",
  "description": "Only a planning contract. It is not a complete rule DSL and must not be executed directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "example_only", "request_id", "project_id", "task", "input_fingerprints", "proposals", "assumptions", "unresolved_questions", "validation_plan", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "example_only": {"type": "boolean"},
    "request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task": {"const": "normalization_suggestion"},
    "input_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "column_id", "operator", "parameters", "evidence_ids", "epistemic_status", "impact", "reason"],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "column_id": {"type": "string", "minLength": 1},
          "operator": {"enum": ["preserve_as_string", "cast_decimal", "parse_date", "parse_local_datetime"]},
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "locale", "precision", "scale", "on_error"],
            "properties": {
              "format": {"type": ["string", "null"]},
              "locale": {"type": ["string", "null"]},
              "precision": {"type": ["integer", "null"], "minimum": 1, "maximum": 38},
              "scale": {"type": ["integer", "null"], "minimum": 0, "maximum": 38},
              "on_error": {"enum": ["fail_batch", "quarantine_row", "keep_raw_with_issue"]}
            }
          },
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "epistemic_status": {"const": "inferred"},
          "impact": {"enum": ["preserve", "type_conversion"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution_authorized": {"const": false}
  }
}
