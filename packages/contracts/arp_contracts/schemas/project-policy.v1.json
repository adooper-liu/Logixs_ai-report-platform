{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arp:project-policy:1.0.0",
  "title": "Project policy v1 (P0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ai", "storage"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allow_raw_sample_egress"],
      "properties": {
        "enabled": {"const": false},
        "allow_raw_sample_egress": {"const": false}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_object_bytes", "retention_days"],
      "properties": {
        "max_object_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "retention_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 36500}
      }
    }
  }
}
